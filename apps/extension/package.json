{
  "name": "@adhdont/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:prod": "wxt build --mode prod",
    "build:firefox:prod": "wxt build -b firefox --mv3 --mode prod",
    "zip:firefox:prod": "wxt zip -b firefox --mv3 --mode prod",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@adhdont/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wxt": "^0.21.5"
  }
}
