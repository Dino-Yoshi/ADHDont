{
  "name": "adhdont",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @adhdont/web --filter @adhdont/api dev",
    "dev:extension": "pnpm --filter @adhdont/extension dev",
    "build:extension": "pnpm --filter @adhdont/extension build",
    "build:extension:firefox": "pnpm --filter @adhdont/extension build:firefox",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web && tsc --noEmit -p apps/extension",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "typescript": "^7.0.2"
  }
}
